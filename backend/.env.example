# ═════════════════════════════════════════════════════════════════════════════
# Attendance Tracker — backend environment.  Copy to backend/.env  (never commit .env)
# Full reference: docs/ENVIRONMENT.md
# ═════════════════════════════════════════════════════════════════════════════

# ── Required ─────────────────────────────────────────────────────────────────
NODE_ENV=development                      # set to "production" when deployed (turns the start-up security checks into hard failures)
PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/   # URL-encode special characters in the password
DB_NAME=attendance_tracker                # the server AND every script use this database name
# >= 32 random characters. Generate:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Browser origin(s) of the frontend, comma separated, exact scheme+host(+port). "*" is refused.
# Production: https only, e.g. https://attendance.example.com
CLIENT_URL=http://localhost:5173

# ── Recommended in production ────────────────────────────────────────────────
# HMAC key for college backup files (>= 16 chars). If unset it is derived from JWT_SECRET.
# Changing it makes older backup files unrestorable.
# BACKUP_SIGNING_KEY=
# Set to true AFTER `npm run migrate:legacy-college` (every account has a college): accounts without one get 403 NO_COLLEGE.
# STRICT_COLLEGE_MEMBERSHIP=false

# ── Optional tuning (defaults shown) ─────────────────────────────────────────
# MONGO_SERVER_SELECTION_TIMEOUT_MS=15000
# TRASH_TTL_DAYS=10                       # days before trashed sessions are purged
# ANALYTICS_CACHE_TTL_MS=15000            # 0 = off
# ACTIVITY_LOG_TTL_DAYS=180
# BACKUP_RATE_MAX=20                      # college backup/restore requests per college per hour
# COLLEGE_REGISTER_MAX=5                  # per IP; window COLLEGE_REGISTER_WINDOW_MS=3600000
# COLLEGE_SEARCH_MAX=60                   # per IP; window COLLEGE_SEARCH_WINDOW_MS=60000
# TEACHER_SIGNUP_MAX=10                   # per IP; window TEACHER_SIGNUP_WINDOW_MS=3600000
# PUBLIC_LOOKUP_MAX=60                    # per IP; window PUBLIC_LOOKUP_WINDOW_MS=60000
# PUBLIC_LOOKUP_FAIL_MAX=15               # failed guesses per IP+college; window PUBLIC_LOOKUP_FAIL_WINDOW_MS=600000
# PUBLIC_LOOKUP_FAIL_IP_MAX=40            # failed guesses per IP (all colleges)
# LOGIN_FAIL_MAX=10                       # failed sign-ins per IP+e-mail; window LOGIN_FAIL_WINDOW_MS=900000
# LOGIN_FAIL_IP_MAX=50                    # failed sign-ins per IP

# ── Only for a pre-multi-college install that is not yet migrated ────────────
# COLLEGE_NAME=                           # report branding for college-less legacy accounts; unused once migrated

# ── scripts/seedAdmin.js (brand-new install without self-registration) ───────
# SEED_ADMIN_NAME=
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=                    # min 12 characters
